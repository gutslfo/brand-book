  "type": {
    "headlineCase": "none",
    "headlineTracking": -0.01,
    "scale": [
      {
        "level": "Display",
        "font": "display",
        "size": 72,
        "leading": 1.05,
        "tracking": -0.02
      },
      {
        "level": "Headline",
        "font": "display",
        "size": 44,
        "leading": 1.1,
        "tracking": -0.01
      },
      {
        "level": "Title",
        "font": "display",
        "size": 28,
        "leading": 1.2,
        "tracking": 0
      },
      {
        "level": "Body",
        "font": "text",
        "size": 16,
        "leading": 1.5,
        "tracking": 0
      },
      {
        "level": "Caption",
        "font": "text",
        "size": 13,
        "leading": 1.4,
        "tracking": 0.01
      }
    ],
    "samples": {
      "Display": "Slow the table",
      "Headline": "Made by hand on the coast",
      "Title": "Calm, tactile, precise",
      "Body": "Each bowl is thrown, trimmed and glazed in our studio, in batches of twelve.",
      "Caption": "Harbour bowl, sea glaze, 14 cm"
    },
    "rules": [
      "Headlines in Newsreader, sentence case, never in capitals",
      "Body in Hanken Grotesk, 16 px minimum on screen",
      "Lines between 45 and 75 characters",
      "No italics: emphasis comes from weight or colour"
    ]
  },
  "layout": {
    "columns": 12,
    "gutter": 2,
    "unit": 8,
    "radius": 2,
    "rules": [
      "One idea per page. White space is part of the product.",
      "Images bleed off the edge or sit on the grid, they never float."
    ]
  },
  "imagery": {
    "direction": "Natural daylight, close enough to see the glaze. Objects in use, on real tables, never on seamless white.",
    "do": [
      "Morning light from one side",
      "Hands, food and table in the frame",
      "Texture sharp, background soft"
    ],
    "dont": [
      "Studio packshots on pure white",
      "Filters, grain or heavy colour grading",
      "Stock photography of any kind"
    ]
  },
