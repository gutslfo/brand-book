{
  "name": "Maren",
  "tagline": "Stoneware from the coast",
  "version": "1.0",
  "date": "September 2026",
  "essence": {
    "purpose": "We make everyday stoneware that slows the table down.",
    "personality": [
      {
        "word": "Calm",
        "line": "Nothing shouts. Space does the work."
      },
      {
        "word": "Tactile",
        "line": "Every surface should make you want to touch it."
      },
      {
        "word": "Precise",
        "line": "Made by hand, never approximate."
      }
    ],
    "voice": [
      {
        "is": "Calm",
        "not": "Sleepy"
      },
      {
        "is": "Precise",
        "not": "Clinical"
      },
      {
        "is": "Warm",
        "not": "Sentimental"
      },
      {
        "is": "Plain",
        "not": "Blunt"
      }
    ],
    "write": "Thrown by hand in small batches, glazed in the colours of the harbour.",
    "avoid": "Discover our amazing handcrafted collection, made with passion!",
    "letter": "Thank you for your order. Each piece was thrown, trimmed and glazed in our studio, so no two are quite the same. Please allow the glaze a week before the first wash."
  },
  "logo": {
    "file": "logo.svg",
    "color": "Sea",
    "clearSpace": 0.5,
    "unitLabel": "half the height of the logo",
    "minWidthPx": 96,
    "minWidthMm": 24,
    "smallUse": "Below that, use the ring symbol on its own.",
    "backgrounds": [
      "Paper",
      "Sand",
      "Foam",
      "Ink",
      "Sea"
    ],
    "misuse": [
      "stretch",
      "rotate",
      "recolor",
