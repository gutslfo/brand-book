      { "word": "Patient", "line": "Nothing rushed, from the dough to the counter." },
      { "word": "Neighbourly", "line": "We know your name and your usual." },
      { "word": "Honest", "line": "Flour, water, salt and time. Nothing else to hide." }
    ],
